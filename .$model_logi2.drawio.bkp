        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\nhide circle\nhide empty members\nleft to right direction\n\nskinparam linetype ortho\nskinparam roundcorner 10\nskinparam shadowing false\nskinparam dpi 150\nskinparam nodesep 55\nskinparam ranksep 85\n\nskinparam class {\n    BackgroundColor #FFFFFF\n    BorderColor #2C3E50\n    BorderThickness 1.5\n    HeaderBackgroundColor #2C3E50\n    HeaderFontColor #FFFFFF\n    HeaderFontSize 14\n    HeaderFontStyle bold\n    FontSize 13\n    AttributeFontSize 13\n    AttributeFontColor #1E293B\n    AttributeIconSize 0\n}\n\nskinparam arrow {\n    Color #475569\n    Thickness 1.4\n    FontSize 12\n    FontColor #1E293B\n    FontStyle bold\n}\n\nclass \&quot;Admini\&quot; as admini {\n  **PK**  &lt;u&gt;id_admin&lt;/u&gt;\n  --\n  nume\n  prenume\n  email\n  parola_hash\n}\n\nclass \&quot;Rute\&quot; as rute {\n  **PK**  &lt;u&gt;id_ruta&lt;/u&gt;\n  --\n  denumire\n  activ\n}\n\nclass \&quot;Opriri\&quot; as opriri {\n  **PK**  &lt;u&gt;id_oprire&lt;/u&gt;\n  --\n  **FK**  id_ruta\n  **FK**  id_statie\n  --\n  ordine\n  ora_plecare\n  ora_sosire\n  distanta\n}\n\nclass \&quot;Statii\&quot; as statii {\n  **PK**  &lt;u&gt;id_statie&lt;/u&gt;\n  --\n  nume\n  oras\n  judet\n  activ\n}\n\nclass \&quot;Curse\&quot; as curse {\n  **PK**  &lt;u&gt;id_cursa&lt;/u&gt;\n  --\n  **FK**  id_admin\n  **FK**  id_ruta\n  **FK**  id_tren\n  --\n  status\n  data_cursa\n  intarziere_minute\n  ora_plecare\n}\n\nclass \&quot;Tipuri_tren\&quot; as tipuri {\n  **PK**  &lt;u&gt;id_tip&lt;/u&gt;\n  --\n  denumire\n  coeficient_pret\n}\n\nclass \&quot;Trenuri\&quot; as trenuri {\n  **PK**  &lt;u&gt;id_tren&lt;/u&gt;\n  --\n  **FK**  id_tip\n  --\n  nume\n  activ\n}\n\nclass \&quot;Vagoane\&quot; as vagoane {\n  **PK**  &lt;u&gt;id_vagon&lt;/u&gt;\n  --\n  **FK**  id_tren\n  --\n  clasa\n  nr_vagon\n}\n\nclass \&quot;Locuri\&quot; as locuri {\n  **PK**  &lt;u&gt;id_loc&lt;/u&gt;\n  --\n  **FK**  id_vagon\n  --\n  nr_loc\n}\n\nclass \&quot;Bilete\&quot; as bilete {\n  **PK**  &lt;u&gt;id_bilet&lt;/u&gt;\n  --\n  **FK**  id_client\n  **FK**  id_cursa\n  **FK**  id_loc\n  **FK**  id_statie_urcare\n  **FK**  id_statie_coborare\n  **FK**  id_reducere\n  --\n  pret_platit\n  status_bilet\n  data_cumpararii\n}\n\nclass \&quot;Clienti\&quot; as clienti {\n  **PK**  &lt;u&gt;id_client&lt;/u&gt;\n  --\n  nume\n  prenume\n  email\n  parola_hash\n  nr_telefon\n}\n\nclass \&quot;Reduceri\&quot; as reduceri {\n  **PK**  &lt;u&gt;id_reduceri&lt;/u&gt;\n  --\n  procent\n  denumire\n}\n\n&#39; Relatii 1 : N\nadmini \&quot;1\&quot; -- \&quot;N\&quot; curse\nrute \&quot;1\&quot; -- \&quot;N\&quot; curse\nrute \&quot;1\&quot; -- \&quot;N\&quot; opriri\nstatii \&quot;1\&quot; -- \&quot;N\&quot; opriri\n\ntipuri \&quot;1\&quot; -- \&quot;N\&quot; trenuri\ntrenuri \&quot;1\&quot; -- \&quot;N\&quot; curse\ntrenuri \&quot;1\&quot; -- \&quot;N\&quot; vagoane\nvagoane \&quot;1\&quot; -- \&quot;N\&quot; locuri\n\ncurse \&quot;1\&quot; -- \&quot;N\&quot; bilete\nstatii \&quot;1\&quot; -- \&quot;N\&quot; bilete : urcare\nstatii \&quot;1\&quot; -- \&quot;N\&quot; bilete : coborare\nlocuri \&quot;1\&quot; -- \&quot;N\&quot; bilete\nclienti \&quot;1\&quot; -- \&quot;N\&quot; bilete\nreduceri \&quot;1\&quot; -- \&quot;N\&quot; bilete\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6T2WSfqKYYCmRoNbIDl--1">
